{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "dependsOn": [
        "^build"
      ]
    },
    "lint": {
      "dependsOn": [
        "^build"
      ]
    },
    "test": {
      "cache": false,
      "passThroughEnv": [
        "TEST_DB_HOST",
        "TEST_DB_PORT",
        "TEST_DB_USERNAME",
        "TEST_DB_PASSWORD"
      ],
      "dependsOn": [
        "^build"
      ]
    }
  }
}
