NODE_ENV=development
PORT=3006
WEB_ORIGIN=http://localhost:3001
# Public web address, used in invite and password reset links
PUBLIC_WEB_URL=http://localhost:3001

# Either DATABASE_URL (Render) or the DB_* settings below
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5456
DB_USERNAME=dscims_user
DB_PASSWORD=dscims_password
DB_DATABASE=dscims_db
DB_SSL=false
# true in development: applies scripts/migrations on start. In production run "pnpm --filter api migrate" before deploying.
RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_DAYS=14
# Days a suspended dealer stays read-only before it is locked
TENANT_GRACE_DAYS=7
BCRYPT_ROUNDS=12

# ---- Email (invites and password resets) -------------------------------------
# With no SMTP settings in development, emails are printed in the API log instead of sent.
# In production with no SMTP settings, invite links are returned to the owner to share by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=d-scims

# ---- Shop location lookup ------------------------------------------------------
# Turns the browser's coordinates into an address. The default is OpenStreetMap Nominatim, which
# requires a real contact in the User-Agent and is not for heavy use. Point GEOCODER_URL at a
# provider with a Nominatim-compatible /reverse endpoint for production volume.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=d-scims/0.1 (contact: you@yourdomain.com)

ENABLE_API_DOCS=false
