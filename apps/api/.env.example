NODE_ENV=development
PORT=3006
WEB_ORIGIN=http://localhost:3001
# Public web address, used in invite and password reset links
PUBLIC_WEB_URL=http://localhost:3001

# Database: DATABASE_URL (Neon, Render) or the DB_* settings below (local Docker).
# With Neon use the pooled string here, add the direct one as MIGRATION_DATABASE_URL, and set DB_SSL=true.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DB_HOST=localhost
DB_PORT=5456
DB_USERNAME=dscims_user
DB_PASSWORD=dscims_password
DB_DATABASE=dscims_db
DB_SSL=false
# true in development: applies scripts/migrations on start. In production the container runs
# `node dist/database/migrate-cli.js` before the server.
RUN_MIGRATIONS=true

REDIS_HOST=localhost
REDIS_PORT=6381
REDIS_URL=

# Generate with: openssl rand -hex 32
JWT_SECRET=
SESSION_DAYS=14
# Days a suspended dealer stays read-only before it is locked
TENANT_GRACE_DAYS=7
BCRYPT_ROUNDS=12

# ---- Email (invites and password resets) -------------------------------------
# MAIL_PROVIDER: resend (development), smtp (production), fake (tests: kept in memory, never sent;
# refused in production). With `fake`, links are printed in the API log.
MAIL_PROVIDER=fake

# Resend (development). Use onboarding@resend.dev as the sender until your own domain is verified.
# RESEND_API_KEY=re_xxxxx
# RESEND_FROM="d-scims <onboarding@resend.dev>"

# SMTP (production). Port 465 is always implicit TLS; 587 upgrades with STARTTLS.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="d-scims <no-reply@example.com>"

# ---- Shop location lookup ------------------------------------------------------
# Turns the browser's coordinates into an address. The default is OpenStreetMap Nominatim, which
# requires a real contact in the User-Agent and is not for heavy use. Point GEOCODER_URL at a
# provider with a Nominatim-compatible /reverse endpoint for production volume.
GEOCODER_URL=https://nominatim.openstreetmap.org/reverse
GEOCODER_USER_AGENT=d-scims/0.1 (rolatzarza@gmail.com)

ENABLE_API_DOCS=false
