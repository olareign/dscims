  "type": "module",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint src/ test/",
    "test": "node scripts/test.mjs run",
    "test:watch": "node scripts/test.mjs",
    "test:cov": "node scripts/test.mjs run --coverage",
    "test:e2e": "node scripts/test.mjs run --config ./vitest.config.e2e.ts",
    "dev": "nest start --watch",
    "migrate": "node dist/database/migrate-cli.js",
    "platform-admin": "node --env-file=.env scripts/platform-admin.mjs"
  },
  "dependencies": {
